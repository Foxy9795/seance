//NIGHTLY  JOB (ACCT),'NIGHTLY BATCH',CLASS=A,MSGCLASS=X
//*
//* Nightly batch: sort the day's transactions, apply them to the
//* indexed customer master, run month-end account maintenance, and
//* keep a backup of the new accounts file if everything went well.
//*
//SORTTRAN EXEC PGM=SORT
//SORTIN   DD DSN=PROD.DAILY.TRANS,DISP=SHR
//SORTOUT  DD DSN=&&SORTED,DISP=(NEW,PASS)
//SYSIN    DD *
  SORT FIELDS=(2,5,CH,A)
/*
//UPDATE   EXEC PGM=CUSTMAST
//CUSTMAST DD DSN=PROD.CUSTOMER.MASTER,DISP=OLD
//TRANSIN  DD DSN=&&SORTED,DISP=(OLD,DELETE)
//RPTOUT   DD SYSOUT=*
//*
//         IF (UPDATE.RC = 0) THEN
//MONTHEND EXEC PGM=ACCOUNTS
//ACCTIN   DD DSN=PROD.ACCOUNTS,DISP=SHR
//ACCTOUT  DD DSN=PROD.ACCOUNTS.NEW,DISP=(NEW,CATLG,DELETE)
//         ENDIF
//*
//BACKUP   EXEC PGM=IEBGENER,COND=(4,LT)
//SYSUT1   DD DSN=PROD.ACCOUNTS.NEW,DISP=SHR
//SYSUT2   DD DSN=PROD.ACCOUNTS.BACKUP,DISP=(NEW,CATLG)
//SYSPRINT DD SYSOUT=*
