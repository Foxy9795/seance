{
  "mcpServers": {
    "seance": {
      "command": ".venv/Scripts/python.exe",
      "args": ["-m", "seance.mcp_server"],
      "env": {
        "PYTHONPATH": "."
      },
      "disabled": false,
      "autoApprove": [
        "list_programs",
        "list_samples",
        "extract_business_rules",
        "assess_workspace",
        "describe_program",
        "describe_layout",
        "run_legacy_program"
      ]
    }
  }
}
