       IDENTIFICATION DIVISION.
       PROGRAM-ID. FEAT3.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SPECIAL-NAMES.
           CONSOLE IS MYCON
           SWITCH-1 IS SW1 ON STATUS IS SW1-ON OFF STATUS IS SW1-OFF
           SWITCH-2 IS SW2 ON STATUS IS SW2-ON
           SYMBOLIC CHARACTERS STAR-CH IS 43
           CLASS HEXA IS "0" THRU "9" "A" THRU "F".
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  GRP USAGE COMP.
           05 B1 PIC S9(4) VALUE 300.
           05 B2 PIC S9(9) VALUE -7.
       01  A PIC 99 VALUE 5.
       01  B PIC 99 VALUE 7.
       01  C PIC 99 VALUE 3.
       01  D PIC 99 VALUE 9.
       01  F PIC S99 VALUE 16.
       01  HX PIC X(4) VALUE "1F0A".
       01  NH PIC X(4) VALUE "1G0A".
       01  UP1 PIC X(5) VALUE "ABC D".
       01  LO1 PIC X(5) VALUE "abc d".
       PROCEDURE DIVISION.
       MAIN-PARA.
           DISPLAY B1 " " B2 " " LENGTH OF GRP.
           IF SW1-ON DISPLAY "SW1 ON" ELSE DISPLAY "SW1 OFF".
           IF SW1-OFF DISPLAY "SW1 IS OFF".
           SET SW1 TO ON.
           IF SW1-ON DISPLAY "NOW ON".
           IF HX IS HEXA DISPLAY "HEX" ELSE DISPLAY "NOT HEX".
           IF NH IS NOT HEXA DISPLAY "NOT HEX 2".
           IF UP1 IS ALPHABETIC-UPPER DISPLAY "UPPER".
           IF LO1 IS ALPHABETIC-LOWER DISPLAY "LOWER".
           DISPLAY "[" STAR-CH "]".
           IF A LESS THAN B AND IS NOT LESS THAN C OR D
              DISPLAY "ABBR1" ELSE DISPLAY "NO1".
           IF A LESS THAN B AND (A GREATER THAN C OR D)
              DISPLAY "ABBR2" ELSE DISPLAY "NO2".
           IF A LESS THAN B AND NOT C OR D
              DISPLAY "ABBR3" ELSE DISPLAY "NO3".
           IF ((0 - A EQUAL TO A OR -11 + F))
              DISPLAY "ABBR4" ELSE DISPLAY "NO4".
           EVALUATE HX NUMERIC
              WHEN TRUE DISPLAY "HX NUMERIC"
              WHEN FALSE DISPLAY "HX NOT NUMERIC"
           END-EVALUATE.
           EVALUATE A > B
              WHEN TRUE DISPLAY "A>B"
              WHEN OTHER DISPLAY "A<=B"
           END-EVALUATE.
           DISPLAY "DONE" UPON MYCON.
           STOP RUN.
