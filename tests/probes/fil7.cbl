       IDENTIFICATION DIVISION.
       PROGRAM-ID. FIL7.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT FI ASSIGN TO "FI7.DAT" ORGANIZATION INDEXED
               ACCESS MODE SEQUENTIAL RECORD KEY FK FILE STATUS S1.
           SELECT FX ASSIGN TO "FX7.DAT" ORGANIZATION INDEXED
               ACCESS MODE SEQUENTIAL RECORD KEY XK FILE STATUS S5.
           SELECT FR ASSIGN TO "FR7.DAT" ORGANIZATION RELATIVE
               ACCESS MODE SEQUENTIAL RELATIVE KEY RK FILE STATUS S2.
           SELECT FV ASSIGN TO "FV7.DAT" ORGANIZATION SEQUENTIAL
               FILE STATUS S3.
           SELECT FD1 ASSIGN TO "NOSUCH7.DAT" ORGANIZATION SEQUENTIAL
               FILE STATUS S4.
       DATA DIVISION.
       FILE SECTION.
       FD FI.
       01 FIR.
          05 FK PIC X(3).
          05 FILLER PIC X(3).
       FD FX.
       01 FXR.
          05 XK PIC X(3).
          05 FILLER PIC X(3).
       FD FR.
       01 FRR PIC X(5).
       FD FV RECORD VARYING FROM 2 TO 8 DEPENDING ON LEN.
       01 FVR PIC X(8).
       FD FD1.
       01 FD1R PIC X(4).
       WORKING-STORAGE SECTION.
       01 S1 PIC XX. 01 S2 PIC XX. 01 S3 PIC XX. 01 S4 PIC XX.
       01 S5 PIC XX.
       01 RK PIC 9(4).
       01 LEN PIC 9(4).
       PROCEDURE DIVISION.
           OPEN EXTEND FX.
           DISPLAY "EXTEND MISSING INDEXED " S5.
           OPEN OUTPUT FI. MOVE "AAAbbb" TO FIR. WRITE FIR. CLOSE FI.
           OPEN I-O FI. MOVE "BBBccc" TO FIR. WRITE FIR.
           DISPLAY "INDEXED SEQ WRITE IN I-O " S1. CLOSE FI.
           OPEN OUTPUT FR. MOVE "ONE" TO FRR. WRITE FRR. CLOSE FR.
           OPEN I-O FR. MOVE "TWO" TO FRR. WRITE FRR.
           DISPLAY "RELATIVE SEQ WRITE IN I-O " S2. CLOSE FR.
           DELETE FILE FD1.
           DISPLAY "DELETE FILE MISSING " S4.
           OPEN OUTPUT FV.
           MOVE "ABCDEFGH" TO FVR. MOVE 1 TO LEN. WRITE FVR.
           DISPLAY "LEN 1 " S3.
           MOVE 9 TO LEN. WRITE FVR.
           DISPLAY "LEN 9 " S3.
           MOVE 4 TO LEN. WRITE FVR.
           DISPLAY "LEN 4 " S3.
           CLOSE FV.
           STOP RUN.
